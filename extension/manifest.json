{
  "manifest_version": 3,
  "name": "Auto Fill — Payment Forms",
  "version": "0.3.0",
  "description": "One-click autofill for Stripe Elements, Checkout, and plain payment forms. Ships 100 US billing profiles with Stripe test cards.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://js.stripe.com/*",
    "https://checkout.stripe.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Fill"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Open Auto Fill popup"
    },
    "fill_default": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Fill active page with default profile"
    },
    "fill_and_submit": {
      "suggested_key": { "default": "Ctrl+Shift+X" },
      "description": "Fill active page and submit"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["autofill-engine.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
