{
  "manifest_version": 3,
  "name": "Auto Fill — Payment Forms",
  "version": "1.0.0",
  "description": "Fill Stripe Elements, Stripe Checkout, and plain payment forms from saved profiles.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://js.stripe.com/*",
    "https://checkout.stripe.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "autofill-engine.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}